# Calibre Web credentials for `dedrm upload` and `dedrm decrypt --upload`.
#
# Copy this file to `.env` in your working directory (or to
# `~/.config/dedrm/.env`) and fill in the values. Process
# environment variables with the same names override these entries.

DEDRM_CALIBRE_URL=http://localhost:8083
DEDRM_CALIBRE_USERNAME=admin
DEDRM_CALIBRE_PASSWORD=change-me

# Set to "false" to skip TLS verification (self-signed certs).
# DEDRM_CALIBRE_VERIFY_TLS=true
